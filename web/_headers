/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.clarity.ms; style-src 'self'; img-src 'self' data: https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://api.web3forms.com https://*.clarity.ms https://c.bing.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'

/assets/*
  Cache-Control: public, max-age=3600

# Las paginas de servicio viven en carpetas, asi que su URL no acaba
# en .html y la regla de abajo no las alcanza. Mismo trato: HTML que
# se revalida siempre, para que un cambio de texto no tarde horas.
/diseno-web-tenerife/*
  Cache-Control: public, max-age=0, must-revalidate

/fotografia-gastronomica-tenerife/*
  Cache-Control: public, max-age=0, must-revalidate

/cartas-digitales-restaurantes/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/config.js
  Cache-Control: public, max-age=0, must-revalidate
